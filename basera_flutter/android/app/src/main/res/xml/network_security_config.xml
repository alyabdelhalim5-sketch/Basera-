<?xml version="1.0" encoding="utf-8"?>
<!-- Allows HTTP (non-HTTPS) connections to the local Wi-Fi backend server -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
